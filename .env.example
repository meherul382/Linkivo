# Public Supabase project values used by the short-link redirect/analytics client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials (never expose to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Private dashboard access. Set both in Vercel Production environment.
LINKIVO_DASHBOARD_PASSWORD=
LINKIVO_SESSION_SECRET=
# Optional: private salt for hashing client IPs in analytics
ANALYTICS_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
