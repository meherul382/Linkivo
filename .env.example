# Public values used by the browser/server auth client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credentials (never expose to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: private salt for hashing client IPs in analytics
ANALYTICS_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
